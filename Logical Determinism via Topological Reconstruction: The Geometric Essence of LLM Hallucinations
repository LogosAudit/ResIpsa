```python
import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.nn.utils import parametrize


# ============================================================
# Utility Classes and Functions
# ============================================================

class OrthogonalProjectionHead(nn.Module):
    """
    Lightweight semi-orthogonal projection head.

    Projects high-dimensional hidden states to a lower-dimensional
    semantic subspace while strictly preserving distances and angles
    (isometry). This strips positional encoding variance and local
    syntactic noise, retaining only the semantic principal components
    relevant to logical consistency.

    Uses PyTorch's native parametrize.orthogonal to guarantee that
    the weight matrix is EXACTLY on the Stiefel manifold at every
    training step. No L2 orthogonality regularization is needed.
    """

    def __init__(self, input_dim, projected_dim):
        super().__init__()
        # Allow projected_dim < input_dim for dimensionality reduction
        # and noise stripping. The semi-orthogonal constraint ensures
        # that distances and angles are preserved in the lower-dim space.
        assert projected_dim <= input_dim, (
            "Projected dim must be <= input dim"
        )
        self.proj = nn.Linear(input_dim, projected_dim, bias=False)
        # Enforce strict semi-orthogonality: W @ W.T = I
        # This runs a Cayley transform or matrix exponential at each
        # step to keep W exactly on the Stiefel manifold.
        parametrize.orthogonal(self.proj, 'weight')

    def forward(self, x):
        return self.proj(x)


def get_sequence_repr(hidden_states, attention_mask):
    """
    Extract robust sequence-level representation via mean pooling
    over non-padding tokens.

    This replaces the fragile last-token heuristic with a global
    semantic centroid that smooths out local syntactic noise while
    preserving proposition-level meaning.
    """
    mask_expanded = (attention_mask.unsqueeze(-1)
                     .expand(hidden_states.size()).float())
    sum_embeddings = torch.sum(hidden_states * mask_expanded, dim=1)
    sum_mask = torch.clamp(mask_expanded.sum(dim=1), min=1e-9)
    return sum_embeddings / sum_mask


# ============================================================
# Training Phase: Entropy-Gated Cycle-Consistency Loss
# ============================================================

def compute_hedge_loss_gated(model, tokenizer, A, B, device,
                             proj_head, beta=20.0, tau_H=4.0,
                             T_temp=1.0,
                             task_prompt_template="{a} implies {b}"):
    """
    Compute entropy-gated cycle-consistency loss with semi-orthogonal
    projection.

    WARNING: ENGINEERING COST — 4x forward passes with full gradient
    graphs. For models >= 7B, gradient_checkpointing is ABSOLUTELY
    MANDATORY. In production, consider concatenating A, B, AB, BA
    into a single batched forward pass to reduce memory fragmentation
    and kernel launch overhead.

    The entropy gate intentionally preserves gradient flow (no detach).
    This is not a bug: it teaches the model to earn its creative leaps
    by maintaining structural certainty. See Section 4.2.1 for the
    theoretical justification.
    """

    # ============================================================
    # 1. Forward Reasoning: A -> B
    # ============================================================

    forward_A_in = tokenizer(A, return_tensors="pt",
                             padding=True, truncation=True).to(device)
    out_A = model(**forward_A_in, output_hidden_states=True)
    h_A_in = get_sequence_repr(out_A.hidden_states[-1],
                               forward_A_in.attention_mask)
    h_A_in_proj = proj_head(h_A_in)

    forward_AB_text = [
        task_prompt_template.format(a=a, b=b) for a, b in zip(A, B)
    ]
    forward_AB_in = tokenizer(forward_AB_text, return_tensors="pt",
                              padding=True, truncation=True).to(device)
    out_AB = model(**forward_AB_in, output_hidden_states=True)
    h_B_out = get_sequence_repr(out_AB.hidden_states[-1],
                                forward_AB_in.attention_mask)
    h_B_out_proj = proj_head(h_B_out)

    forward_residual = h_B_out_proj - h_A_in_proj

    # Compute entropy for gating
    logits_AB = out_AB.logits[:, -1, :]
    scaled_logits = logits_AB / T_temp
    probs_AB = F.softmax(scaled_logits, dim=-1)
    H_t = -torch.sum(probs_AB * torch.log(probs_AB + 1e-8), dim=-1)

    # ============================================================
    # 2. Backward Reasoning: B -> A
    # ============================================================

    backward_B_in = tokenizer(B, return_tensors="pt",
                              padding=True, truncation=True).to(device)
    out_B = model(**backward_B_in, output_hidden_states=True)
    h_B_in = get_sequence_repr(out_B.hidden_states[-1],
                               backward_B_in.attention_mask)
    h_B_in_proj = proj_head(h_B_in)

    backward_BA_text = [
        task_prompt_template.format(a=b, b=a) for a, b in zip(A, B)
    ]
    backward_BA_in = tokenizer(backward_BA_text, return_tensors="pt",
                               padding=True, truncation=True).to(device)
    out_BA = model(**backward_BA_in, output_hidden_states=True)
    h_A_out = get_sequence_repr(out_BA.hidden_states[-1],
                                backward_BA_in.attention_mask)
    h_A_out_proj = proj_head(h_A_out)

    backward_residual = h_A_out_proj - h_B_in_proj

    # ============================================================
    # 3. Compute Gated Loss
    # ============================================================

    cycle_residual = forward_residual + backward_residual
    cycle_norm_sq = torch.norm(cycle_residual, p=2, dim=-1) ** 2

    gate = torch.sigmoid(beta * (H_t - tau_H))
    L_hedge = (gate * cycle_norm_sq).mean()

    return L_hedge


# ============================================================
